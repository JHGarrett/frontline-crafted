{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/weatherford-tx-custom-woodworking",
      "destination": "/weatherford-tx-custom-woodworking/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/configurator",
      "destination": "/#contact",
      "permanent": true
    }
  ]
}
